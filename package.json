{
  "name": "t3-deck",
  "version": "1.0.0",
  "description": "Real-time T3 Code mission control plugin for Elgato Stream Deck+",
  "license": "Apache-2.0",
  "author": "Charles Bine",
  "repository": {
    "type": "git",
    "url": "https://github.com/metaember/t3-deck.git"
  },
  "keywords": [
    "t3-code",
    "t3code",
    "stream-deck",
    "stream-deck-plus",
    "elgato",
    "coding-agents",
    "claude-code",
    "codex"
  ],
  "type": "module",
  "scripts": {
    "build": "rollup --config",
    "build:profile": "tsx scripts/build-profile.ts",
    "dev": "rollup --config --watch",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "streamdeck validate com.charlesbine.t3-deck.sdPlugin",
    "pack": "npm run build && npm run build:profile && npm run validate && streamdeck pack --force com.charlesbine.t3-deck.sdPlugin",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.4",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.0.0",
    "rollup": "^4.50.0",
    "tslib": "^2.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
